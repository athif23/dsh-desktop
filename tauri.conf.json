{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dsh-desktop",
  "version": "0.1.2",
  "identifier": "com.github.athif23.dsh-desktop",
  "build": {
    "frontendDist": "./dist-stub"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "athif23",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "shortDescription": "Native desktop shell for DSH",
    "longDescription": "dsh-desktop hosts upstream dsh web in a native window with a real browser surface, and keeps its own backend updated from upstream.",
    "category": "DeveloperTool",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
